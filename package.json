{
  "name": "barbarian",
  "productName": "Barbarian",
  "version": "0.1.0",
  "private": true,
  "description": "A local command center for developer work, reviews, and AI agents.",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm build:server && pnpm build:web && pnpm build:extensions && pnpm build:desktop",
    "build:desktop": "esbuild apps/desktop/src/main.ts --bundle --platform=node --external:electron --outfile=dist/desktop/main.cjs && esbuild apps/desktop/src/preload.ts --bundle --platform=node --external:electron --outfile=dist/desktop/preload.cjs && node scripts/create-macos-icon.mjs",
    "build:extensions": "pnpm --filter @barbarian/chrome-extension build && pnpm --filter barbarian-vscode-extension build",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "assets:weapons": "node scripts/sync-weapon-assets.mjs",
    "clean:reviews": "tsx scripts/cleanup-review-workspaces.mts",
    "configure": "tsx scripts/init-config.mts",
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "desktop:dev": "pnpm build && concurrently -k -n web,electron -c cyan,magenta \"pnpm dev:web\" \"electron . --dev-url=http://127.0.0.1:4141\"",
    "desktop:package": "pnpm migrate:state && pnpm build && pnpm package:vscode && electron-builder --mac dir",
    "package:vscode": "node scripts/package-vscode-extension.mjs",
    "migrate:state": "tsx scripts/migrate-state.mts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/vscode-extension/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "sync": "tsx scripts/sync.mts",
    "link:skills": "node scripts/link-skills.mjs",
    "service:install": "node scripts/install-launch-agent.mjs",
    "vscode:install": "node scripts/install-vscode-extension.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "local.barbarian.desktop",
    "productName": "Barbarian",
    "asar": false,
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/desktop/**/*",
      "dist/server/**/*",
      "dist/web/**/*",
      "dist/extensions/**/*",
      "apps/chrome-extension/**/*",
      "config/barbarian.example.yaml",
      ".env.example",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "dist/desktop/Barbarian.icns",
      "identity": null
    }
  }
}
