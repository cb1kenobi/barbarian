{
  "name": "barbarian",
  "version": "0.1.0",
  "private": true,
  "description": "A local command center for developer work, reviews, and AI agents.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm build:server && pnpm build:web && pnpm build:extensions",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:extensions": "pnpm --filter @barbarian/chrome-extension build && pnpm --filter barbarian-vscode-extension build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/vscode-extension/tsconfig.json --noEmit",
    "sync": "tsx scripts/sync.mts",
    "configure": "tsx scripts/init-config.mts",
    "link:skills": "node scripts/link-skills.mjs",
    "clean:reviews": "tsx scripts/cleanup-review-workspaces.mts",
    "service:install": "node scripts/install-launch-agent.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
