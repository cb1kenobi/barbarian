# GitHub CLI authentication is preferred. This is optional if `gh auth status` works.
GITHUB_TOKEN=

# Optional providers used by configured local agent CLIs or integrations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional long-lived tokens for separate Claude subscription accounts. Generate each with
# `claude setup-token`, give it a unique name, and reference that name from a provider env block.
CLAUDE_SECONDARY_OAUTH_TOKEN=
GEMINI_API_KEY=
CURSOR_API_KEY=
LINEAR_API_KEY=
