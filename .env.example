# Barbarian only binds to localhost.
BARBARIAN_HOST=127.0.0.1
BARBARIAN_PORT=4142

# GitHub CLI authentication is preferred. This is optional if `gh auth status` works.
GITHUB_TOKEN=

# Optional providers used by configured local agent CLIs or integrations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LINEAR_API_KEY=

