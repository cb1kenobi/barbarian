{
  "name": "barbarian-vscode-extension",
  "displayName": "Barbarian Branch Review",
  "description": "Review the current git branch with Barbarian, with optional pull request context.",
  "version": "0.2.3",
  "private": true,
  "license": "UNLICENSED",
  "publisher": "local",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "activationEvents": ["onView:barbarian.branchReview", "onCommand:barbarian.refreshBranch"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "barbarian.refreshBranch", "title": "Barbarian: Show Branch Review" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "barbarian", "title": "Barbarian", "icon": "media/barbarian.svg" }
      ]
    },
    "views": {
      "barbarian": [
        { "type": "webview", "id": "barbarian.branchReview", "name": "Branch Review" }
      ]
    }
  },
  "files": ["dist/extension.js", "media/barbarian.svg", "LICENSE"],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9"
  }
}
