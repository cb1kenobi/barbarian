{
  "name": "barbarian-vscode-extension",
  "displayName": "Barbarian Branch Review",
  "description": "Review the current git branch with Barbarian, with optional pull request context.",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "publisher": "local",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "activationEvents": ["onView:barbarian.branchReview", "onCommand:barbarian.refreshBranch", "onCommand:barbarian.configureConnection"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "barbarian.refreshBranch", "title": "Barbarian: Show Branch Review" },
      { "command": "barbarian.configureConnection", "title": "Barbarian: Configure Server Connection" }
    ],
    "configuration": {
      "title": "Barbarian",
      "properties": {
        "barbarian.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4142",
          "description": "Complete URL of the Barbarian server. Remote clients should use the server Mac's VPN hostname or VPN IP address."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "barbarian", "title": "Barbarian", "icon": "media/barbarian.svg" }
      ]
    },
    "views": {
      "barbarian": [
        { "type": "webview", "id": "barbarian.branchReview", "name": "Branch Review" }
      ]
    }
  },
  "files": ["dist/extension.js", "media/barbarian.svg", "media/weapons/*.svg", "LICENSE"],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9"
  }
}
